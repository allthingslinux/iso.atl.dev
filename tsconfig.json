{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@iso/db": ["packages/db/src/index.ts"],
      "@iso/api": ["packages/api/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
